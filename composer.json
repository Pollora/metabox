{
    "name": "pollora/metabox",
    "description": "Declare Meta Box meta boxes, fields, blocks and settings pages with a fluent PHP API.",
    "type": "library",
    "keywords": [
        "wordpress",
        "meta-box",
        "metabox",
        "custom-fields",
        "gutenberg-blocks",
        "fluent",
        "pollora"
    ],
    "homepage": "https://github.com/Pollora/metabox",
    "license": "MIT",
    "authors": [
        {
            "name": "Amphibee",
            "email": "contact@amphibee.fr"
        }
    ],
    "support": {
        "issues": "https://github.com/Pollora/metabox/issues",
        "source": "https://github.com/Pollora/metabox"
    },
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "rector/rector": "^2.0.0",
        "nunomaduro/phpinsights": "^2.8",
        "laravel/pint": "^1.22",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Pollora\\Metabox\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@test:unit",
            "@phpstan",
            "@lint:check"
        ],
        "test:unit": "pest",
        "test:coverage": "pest --coverage",
        "phpstan": "phpstan analyse",
        "phpstan:ci": "phpstan analyse --no-progress",
        "lint": "pint",
        "lint:check": "pint --test"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "3.x-dev"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
